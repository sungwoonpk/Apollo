{
  "name": "apollo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @apollo/desktop dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "eval": "node apps/desktop/scripts/native-abi.mjs node && vite-node eval/run.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3",
      "onnxruntime-node",
      "@picovoice/porcupine-node"
    ],
    "overrides": {
      "adm-zip@<0.6.1": "^0.6.1",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "^4.2.3",
      "follow-redirects@>=1.16.0 <1.16.2": "^1.16.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "qs@>=2.2.5 <6.16.1": "^6.16.1",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "undici@>=7.0.0 <7.30.1": "^7.30.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
